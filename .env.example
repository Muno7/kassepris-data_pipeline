# Kassepris scraper configuration.
#
# Copy to `.env` (base / development) and, if you want per-environment
# overrides, to `.env.development` / `.env.test` / `.env.production`. The file
# for the active APP_ENV is loaded first and wins; `.env` fills in the rest
# (so shared secrets can live only in `.env`). Real production values are
# injected by the deploy environment - do not commit them.

# development (default) | test | production. Selects which .env.<APP_ENV> file
# is layered on top of .env, plus per-env defaults (SSL, fetch politeness).
APP_ENV=development

# --- Database -------------------------------------------------------------
# development: local Postgres. test: the dockerized throwaway Postgres from
# docker-compose.yml. production: AWS RDS.
DB_URL=postgresql://user@localhost:5432/supermarket_scraper
# SSL is forced on in production regardless; set here to enable it elsewhere.
DB_SSL=false
# Leave false for RDS's default CA; set true once a CA bundle is configured.
DB_SSL_REJECT_UNAUTHORIZED=false

# --- Coop API keys (public keys from Coop's own web bundle, not secrets) ---
COOP_PRODUCTS_SUBSCRIPTION_KEY=
COOP_STORE_INFO_SUBSCRIPTION_KEY=

# --- Fetch tuning (all optional; defaults shown) --------------------------
# Concurrency: how many store fetches run at once, per chain.
COOP_FETCH_CONCURRENCY=10
ICA_FETCH_CONCURRENCY=3
WILLYS_FETCH_CONCURRENCY=6

# Per-request retries (httpClient backoff) before a request is considered failed.
COOP_FETCH_MAX_RETRIES=4
ICA_FETCH_MAX_RETRIES=4
WILLYS_FETCH_MAX_RETRIES=4

# Whole-store retry passes after per-request retries are exhausted (Coop/ICA).
COOP_FETCH_STORE_RETRY_PASSES=2
ICA_FETCH_STORE_RETRY_PASSES=2

# Min spacing between request starts, in ms. Two tiers:
#
#   dev/test  = "block-avoiding" limits. Go as fast as each chain actually
#               allows. Coop/Willys have no server-side limit (0ms). ICA
#               enforces ~72 req/60s per IP with 403 blocks, so it must stay
#               at ~850ms even in test - lower and the IP gets blocked. These
#               are the code defaults, so dev/test need no override.
#
#   production = "soft" politeness the chains ask for, with margin. Raise all
#               three so we're a well-behaved citizen, not just un-blocked:
#                 COOP_FETCH_MIN_DELAY_MS=150
#                 ICA_FETCH_MIN_DELAY_MS=1200      # comfortably under 72/60s
#                 WILLYS_FETCH_MIN_DELAY_MS=300     # /sok is crawl-sensitive
#               (and consider lower *_FETCH_CONCURRENCY in production too).
COOP_FETCH_MIN_DELAY_MS=0
ICA_FETCH_MIN_DELAY_MS=850
WILLYS_FETCH_MIN_DELAY_MS=0

# Willys GTIN-recovery fallback (backs willys.se/sok; keep low).
WILLYS_GTIN_FALLBACK_CONCURRENCY=3

{
  "name": "supermarket-api",
  "version": "1.0.0",
  "description": "Fetch-based (no browser) pipeline for store discovery, location enrichment, and product offers for Coop, ICA, and Willys. Willys store discovery still uses Puppeteer; its product offers are now API-based too.",
  "main": "run.js",
  "type": "module",
  "scripts": {
    "stores:fetch": "node stores/run.js",
    "stores:update-db": "node stores/update_db.js",
    "stores:willys:update-db": "node stores/scripts/import_stores.js",
    "stores:willys:enrich-locations": "node stores/scripts/enrich_locations.js",
    "products:fetch": "node products/run.js",
    "products:update-db": "node products/update_db.js",
    "products:willys:fetch": "node products/willys/fetch.js",
    "products:willys:normalize": "node products/willys/normalize.js",
    "db:schema": "node db/apply-schema.js",
    "db:init": "bash scripts/init-db.sh",
    "db:migrate": "node db/migrate.js",
    "products:update-all": "bash scripts/update-products.sh"
  },
  "license": "ISC",
  "dependencies": {
    "dotenv": "^17.2.3",
    "pg": "^8.16.3",
    "puppeteer": "^24.22.2"
  }
}
